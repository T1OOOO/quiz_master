    {
      "name": "missing_persisted_sequence",
      "input": {"operation":"schema_mutation","target":"host_event","path":["sequence"],"mutation":{"kind":"remove"},"validator":"event_schema"},
      "expected_error": "schema.host_event.sequence.required_property_missing"
