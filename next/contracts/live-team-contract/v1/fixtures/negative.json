    {
      "name": "presenter_pre_reveal_secret_leak",
      "input": {"operation":"schema_mutation","target":"presenter_event","path":["data","correct_answer"],"mutation":{"kind":"set","value":{"option_id":"opt-sun"}},"validator":"event_schema"},
      "expected_error": "schema.presenter_event.data.correct_answer.unknown_property"
    },
    {
      "name": "team_pre_reveal_secret_leak",
      "input": {"operation":"schema_mutation","target":"team_event","path":["data","answer"],"mutation":{"kind":"set","value":{"option_id":"opt-sun"}},"validator":"event_schema"},
      "expected_error": "schema.team_event.data.answer.unknown_property"
    },
    {
      "name": "host_pre_reveal_grading_leak",
      "input": {"operation":"schema_mutation","target":"host_event","path":["data","grading"],"mutation":{"kind":"set","value":{"is_correct":true}},"validator":"event_schema"},
      "expected_error": "schema.host_event.data.grading.unknown_property"
