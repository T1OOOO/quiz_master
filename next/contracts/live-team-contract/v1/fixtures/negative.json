{
  "cases": [
    {
      "name": "qr_to_host_escalation",
      "input": {"operation":"authorize_host","credential_kind":"invite","actor_id":"captain-red","host_id":"host-001","command":"round.close"},
      "expected_error": "host_auth.invite_not_host"
    },
    {
      "name": "team_name_takeover",
      "input": {"operation":"authorize_team","team_name":"Red Team","actor_id":"captain-blue","team_id":"team-red","captain_id":"captain-red"},
      "expected_error": "team_auth.team_name_not_identity"
    },
    {
      "name": "expired_invite",
      "input": {"operation":"admission","qr_token":"0123456789abcdef0123456789abcdef","manual_code":"0A1B2C3D","expires_at":"2026-09-20T22:00:00Z","revoked":false,"rotated":false,"session_phase":"lobby","admission":"open","team_count":2,"server_at":"2026-09-20T22:00:01Z"},
      "expected_error": "admission.invite_expired"
    },
    {
      "name": "revoked_invite",
      "input": {"operation":"admission","qr_token":"0123456789abcdef0123456789abcdef","manual_code":"0A1B2C3D","expires_at":"2026-09-20T22:00:00Z","revoked":true,"rotated":false,"session_phase":"lobby","admission":"open","team_count":2,"server_at":"2026-09-20T10:00:00Z"},
      "expected_error": "admission.invite_revoked"
    },
    {
      "name": "rotated_invite",
      "input": {"operation":"admission","qr_token":"0123456789abcdef0123456789abcdef","manual_code":"0A1B2C3D","expires_at":"2026-09-20T22:00:00Z","revoked":false,"rotated":true,"session_phase":"lobby","admission":"open","team_count":2,"server_at":"2026-09-20T10:00:00Z"},
      "expected_error": "admission.invite_rotated"
    },
    {
      "name": "ambiguous_manual_code",
      "input": {"operation":"validate_manual_code","manual_code":"O0IL0000"},
      "expected_error": "manual_code.ambiguous_character"
    },
    {
      "name": "short_manual_code",
      "input": {"operation":"validate_manual_code","manual_code":"A1B2C3D"},
      "expected_error": "manual_code.short_length"
    },
    {
      "name": "token_leakage",
      "input": {"operation":"schema_mutation","target":"presenter_event","path":["data","qr_token"],"mutation":{"kind":"set","value":"0123456789abcdef0123456789abcdef"},"validator":"event_schema"},
      "expected_error": "schema.presenter_event.data.qr_token.unknown_property"
    },
    {
      "name": "join_after_lock",
      "input": {"operation":"admission","qr_token":"0123456789abcdef0123456789abcdef","manual_code":"0A1B2C3D","expires_at":"2026-09-20T22:00:00Z","revoked":false,"rotated":false,"session_phase":"lobby","admission":"locked","team_count":2,"server_at":"2026-09-20T10:00:00Z"},
      "expected_error": "admission.locked"
    },
    {
      "name": "join_after_start",
      "input": {"operation":"admission","qr_token":"0123456789abcdef0123456789abcdef","manual_code":"0A1B2C3D","expires_at":"2026-09-20T22:00:00Z","revoked":false,"rotated":false,"session_phase":"active","admission":"open","team_count":2,"server_at":"2026-09-20T10:00:00Z"},
      "expected_error": "admission.session_started"
    },
    {
      "name": "fifty_first_team",
      "input": {"operation":"admission","qr_token":"0123456789abcdef0123456789abcdef","manual_code":"0A1B2C3D","expires_at":"2026-09-20T22:00:00Z","revoked":false,"rotated":false,"session_phase":"lobby","admission":"open","team_count":50,"server_at":"2026-09-20T10:00:00Z"},
      "expected_error": "admission.capacity_reached"
    },
    {
      "name": "second_captain",
      "input": {"operation":"claim_captain","existing_captain_id":"captain-red","requested_captain_id":"captain-blue"},
      "expected_error": "captain.already_claimed"
    },
    {
      "name": "unauthorized_captain_transfer",
      "input": {"operation":"captain_transfer","actor_id":"captain-red","host_id":"host-001","current_captain_id":"captain-red","new_captain_id":"captain-blue"},
      "expected_error": "transfer.actor_not_host"
    },
    {
