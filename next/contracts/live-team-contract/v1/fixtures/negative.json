    {
      "name": "cross_team_result_access",
      "input": {"operation":"result_request","access":{"session_id":"session-live-001","audience":"team","scope":"own_answers_and_standings","credential_kind":"authenticated"},"requester_team_id":"team-red","target_team_id":"team-blue","server_at":"2026-09-20T12:00:00Z","requested_fields":["own_answers","standings"]},
      "expected_error": "result_access.cross_team"
    },
    {
      "name": "expired_public_link",
      "input": {"operation":"result_request","access":{"session_id":"session-live-001","audience":"public","scope":"final_standings_and_reveals","credential_kind":"public_share","share_token":"0123456789abcdef0123456789abcdef","share_expires_at":"2026-09-27T10:00:00Z","share_revoked":false},"requester_team_id":null,"target_team_id":null,"server_at":"2026-09-27T10:00:01Z","requested_fields":["final_standings"]},
      "expected_error": "result_access.public_expired"
    },
    {
      "name": "revoked_public_link",
      "input": {"operation":"result_request","access":{"session_id":"session-live-001","audience":"public","scope":"final_standings_and_reveals","credential_kind":"public_share","share_token":"0123456789abcdef0123456789abcdef","share_expires_at":"2026-09-27T10:00:00Z","share_revoked":true},"requester_team_id":null,"target_team_id":null,"server_at":"2026-09-21T10:00:00Z","requested_fields":["final_standings"]},
      "expected_error": "result_access.public_revoked"
    },
    {
      "name": "public_link_raw_answers",
      "input": {"operation":"result_request","access":{"session_id":"session-live-001","audience":"public","scope":"final_standings_and_reveals","credential_kind":"public_share","share_token":"0123456789abcdef0123456789abcdef","share_expires_at":"2026-09-27T10:00:00Z","share_revoked":false},"requester_team_id":null,"target_team_id":null,"server_at":"2026-09-21T10:00:00Z","requested_fields":["raw_team_answers"]},
      "expected_error": "result_access.public_overexposure"
    },
    {
      "name": "duplicate_reconnect",
      "input": {"operation":"replay_event","request":{"session_id":"session-live-001","audience":"team","last_seen_sequence":6,"mode":"contiguous_events"},"event_sequence":6,"event_room_version":4,"current_room_version":4,"available_from_sequence":5,"target_team_id":"team-red","authorized_team_id":"team-red"},
      "expected_error": "replay.duplicate_or_stale_event"
    },
    {
      "name": "gap_reconnect",
      "input": {"operation":"replay_event","request":{"session_id":"session-live-001","audience":"team","last_seen_sequence":4,"mode":"contiguous_events"},"event_sequence":6,"event_room_version":4,"current_room_version":4,"available_from_sequence":6,"target_team_id":"team-red","authorized_team_id":"team-red"},
      "expected_error": "replay.gap_requires_snapshot"
    },
    {
      "name": "stale_reconnect",
      "input": {"operation":"replay_event","request":{"session_id":"session-live-001","audience":"team","last_seen_sequence":2,"mode":"contiguous_events"},"event_sequence":3,"event_room_version":3,"current_room_version":4,"available_from_sequence":3,"target_team_id":"team-red","authorized_team_id":"team-red"},
      "expected_error": "replay.stale_room_version"
