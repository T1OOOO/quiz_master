    {
      "name": "client_clock_authority",
      "input": {"operation":"submit_answer","round_id":"round-001","question_revision":{"number":1,"sha256":"2222222222222222222222222222222222222222222222222222222222222222"},"bundle_sha256":"886816179d39228d08c932c281e052636d6fd8bc6075b9421f623bb001bd2dd3","server_received_at":"2026-09-20T10:01:01Z","client_at":"2026-09-20T10:00:30Z","idempotency_key":"answer-red-002","payload_digest":"3333333333333333333333333333333333333333333333333333333333333333","prior_answer":null,"serialized_first":"answer"},
      "expected_error": "answer.client_clock_not_authoritative"
