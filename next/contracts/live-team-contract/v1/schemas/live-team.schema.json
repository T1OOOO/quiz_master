{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-team-contract/v1/live-team",
  "title": "Live team persisted records and HTTP exchanges",
  "type": "object", "additionalProperties": false,
  "required": ["session_id", "host_id", "bundle_version", "bundle_sha256", "scoring_policy_version", "settings", "state"],
  "properties": {
    "session_id": {"$ref": "#/$defs/id"}, "host_id": {"$ref": "#/$defs/id"},
    "bundle_version": {"type": "string", "minLength": 1}, "bundle_sha256": {"$ref": "#/$defs/hash"},
    "scoring_policy_version": {"const": "scoring/v1"}, "settings": {"$ref": "#/$defs/settings"}, "state": {"$ref": "#/$defs/state"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^.*Z$"},
    "revision": {"type": "object", "additionalProperties": false, "required": ["number", "sha256"], "properties": {"number": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "settings": {"type": "object", "additionalProperties": false, "required": ["team_capacity", "round_seconds", "auto_close_when_all_answer"], "properties": {"team_capacity": {"const": 50}, "round_seconds": {"type": "integer", "minimum": 1}, "auto_close_when_all_answer": {"type": "boolean"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["phase", "room_version", "event_sequence", "admission"], "properties": {"phase": {"enum": ["lobby", "active", "finished", "cancelled"]}, "room_version": {"type": "integer", "minimum": 1}, "event_sequence": {"type": "integer", "minimum": 0}, "admission": {"enum": ["open", "locked"]}}},
    "invitation": {"type": "object", "additionalProperties": false, "required": ["invite_id", "session_id", "qr_token", "manual_code", "expires_at", "revoked", "rotated"], "properties": {"invite_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "qr_token": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "manual_code": {"type": "string", "pattern": "^[0-9ABCDEFGHJKMNPQRSTVWXYZ]{8}$"}, "expires_at": {"$ref": "#/$defs/utc"}, "revoked": {"type": "boolean"}, "rotated": {"type": "boolean"}}},
    "joinExchange": {"type": "object", "additionalProperties": false, "required": ["session_id", "team_id", "captain_id", "resume_token", "resume_expires_at", "generic_failure"], "properties": {"session_id": {"$ref": "#/$defs/id"}, "team_id": {"$ref": "#/$defs/id"}, "captain_id": {"$ref": "#/$defs/id"}, "resume_token": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "resume_expires_at": {"$ref": "#/$defs/utc"}, "generic_failure": {"const": "invalid_join"}}},
    "round": {"type": "object", "additionalProperties": false, "required": ["round_id", "session_id", "state", "bundle_version", "bundle_sha256", "question_id", "question_revision", "option_order", "server_opened_at", "server_deadline_at"], "properties": {"round_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["prepared", "open", "closed", "revealed", "complete"]}, "bundle_version": {"type": "string", "minLength": 1}, "bundle_sha256": {"$ref": "#/$defs/hash"}, "question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "option_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "server_opened_at": {"$ref": "#/$defs/utc"}, "server_deadline_at": {"$ref": "#/$defs/utc"}}},
    "answer": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["option_id"], "properties": {"option_id": {"$ref": "#/$defs/id"}}}, {"type": "object", "additionalProperties": false, "required": ["option_ids"], "properties": {"option_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}}, {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}}}]},
    "answerReceipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "session_id", "round_id", "team_id", "captain_id", "question_id", "question_revision", "payload_digest", "accepted_at"], "properties": {"receipt_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "round_id": {"$ref": "#/$defs/id"}, "team_id": {"$ref": "#/$defs/id"}, "captain_id": {"$ref": "#/$defs/id"}, "question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "payload_digest": {"$ref": "#/$defs/hash"}, "accepted_at": {"$ref": "#/$defs/utc"}}},
    "answerWrite": {"type": "object", "additionalProperties": false, "required": ["session_id", "round_id", "team_id", "captain_id", "bundle_sha256", "question_id", "question_revision", "answer", "idempotency_key", "payload_digest", "receipt"], "properties": {"session_id": {"$ref": "#/$defs/id"}, "round_id": {"$ref": "#/$defs/id"}, "team_id": {"$ref": "#/$defs/id"}, "captain_id": {"$ref": "#/$defs/id"}, "bundle_sha256": {"$ref": "#/$defs/hash"}, "question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "answer": {"$ref": "#/$defs/answer"}, "idempotency_key": {"type": "string", "minLength": 1}, "payload_digest": {"$ref": "#/$defs/hash"}, "receipt": {"$ref": "#/$defs/answerReceipt"}}},
    "reconnect": {"type": "object", "additionalProperties": false, "required": ["session_id", "audience", "last_seen_sequence", "mode"], "properties": {"session_id": {"$ref": "#/$defs/id"}, "audience": {"enum": ["host", "presenter", "team", "public"]}, "last_seen_sequence": {"type": "integer", "minimum": 0}, "mode": {"enum": ["contiguous_events", "audience_snapshot"]}}},
    "resultAccess": {"oneOf": [{"type":"object","additionalProperties":false,"required":["session_id","audience","scope","credential_kind"],"properties":{"session_id":{"$ref":"#/$defs/id"},"audience":{"const":"host"},"scope":{"const":"full_session"},"credential_kind":{"const":"authenticated"}}},{"type":"object","additionalProperties":false,"required":["session_id","audience","scope","credential_kind"],"properties":{"session_id":{"$ref":"#/$defs/id"},"audience":{"const":"team"},"scope":{"const":"own_answers_and_standings"},"credential_kind":{"const":"authenticated"}}},{"type":"object","additionalProperties":false,"required":["session_id","audience","scope","credential_kind","share_token","share_expires_at","share_revoked"],"properties":{"session_id":{"$ref":"#/$defs/id"},"audience":{"const":"public"},"scope":{"const":"final_standings_and_reveals"},"credential_kind":{"const":"public_share"},"share_token":{"type":"string","pattern":"^[0-9a-f]{32}$"},"share_expires_at":{"$ref":"#/$defs/utc"},"share_revoked":{"type":"boolean"}}}]}
  }
}
