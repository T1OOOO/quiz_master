{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "quiz-contract/v1/room-event", "title": "Base room event envelope; P33 extension intentionally pending", "type": "object", "additionalProperties": false,
  "required": ["session_id", "round_id", "sequence", "room_version", "server_at", "audience", "kind", "data"],
  "properties": {"session_id": {"$ref": "#/$defs/id"}, "round_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1}, "room_version": {"type": "integer", "minimum": 1}, "server_at": {"type": "string", "format": "date-time"}, "audience": {"enum": ["participant", "host", "presenter", "all"]}, "kind": {"enum": ["round.opened", "round.closed", "question.revealed"]}, "data": {"oneOf": [{"$ref": "#/$defs/roundOpenedData"}, {"$ref": "#/$defs/emptyData"}]}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "roundOpenedData": {"type": "object", "additionalProperties": false, "required": ["question_id"], "properties": {"question_id": {"$ref": "#/$defs/id"}}}, "emptyData": {"type": "object", "additionalProperties": false, "maxProperties": 0}},
  "description": "P33 must introduce a separately versioned team extension for join, captain, team scoring, standings and immediate correctness. No base-v1 field authorizes those data."
}
