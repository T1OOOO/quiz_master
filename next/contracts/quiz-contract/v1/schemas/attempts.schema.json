{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "quiz-contract/v1/attempts", "title": "Attempt start, snapshot, answer receipt, finish and history", "type": "object", "additionalProperties": false,
  "required": ["attempt_id", "participant_id", "bundle_version", "bundle_sha256", "scoring_policy_version", "question_snapshots", "status"],
  "properties": {"attempt_id": {"$ref": "#/$defs/id"}, "participant_id": {"$ref": "#/$defs/id"}, "bundle_version": {"type": "string", "minLength": 1}, "bundle_sha256": {"$ref": "#/$defs/hash"}, "scoring_policy_version": {"const": "scoring/v1"}, "question_snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/snapshot"}}, "status": {"enum": ["started", "finished"]}, "history": {"type": "array", "items": {"$ref": "#/$defs/history"}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "object", "additionalProperties": false, "required": ["number", "sha256"], "properties": {"number": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["question_id", "question_revision", "option_order", "position_to_option_id"], "properties": {"question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "option_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "position_to_option_id": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}}}},
    "answer": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["option_id"], "properties": {"option_id": {"$ref": "#/$defs/id"}}},
      {"type": "object", "additionalProperties": false, "required": ["option_ids"], "properties": {"option_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}},
      {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string"}}}
    ]},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "attempt_id", "participant_id", "question_id", "question_revision", "accepted_at"], "properties": {"receipt_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "participant_id": {"$ref": "#/$defs/id"}, "question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "accepted_at": {"type": "string", "format": "date-time"}}},
    "answerWrite": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "participant_id", "question_id", "question_revision", "answer", "idempotency_key", "payload_digest", "receipt", "accepted_at", "same_key_same_payload", "same_key_same_payload_receipt_id", "same_key_different_payload"], "properties": {"attempt_id": {"$ref": "#/$defs/id"}, "participant_id": {"$ref": "#/$defs/id"}, "question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "answer": {"$ref": "#/$defs/answer"}, "idempotency_key": {"type": "string", "minLength": 1}, "payload_digest": {"$ref": "#/$defs/hash"}, "receipt": {"$ref": "#/$defs/receipt"}, "accepted_at": {"type": "string", "format": "date-time"}, "same_key_same_payload": {"const": "same_receipt"}, "same_key_same_payload_receipt_id": {"$ref": "#/$defs/id"}, "same_key_different_payload": {"const": "idempotency_conflict"}}},
    "history": {"type": "object", "additionalProperties": false, "required": ["question_id", "question_revision", "receipt_id"], "properties": {"question_id": {"$ref": "#/$defs/id"}, "question_revision": {"$ref": "#/$defs/revision"}, "receipt_id": {"$ref": "#/$defs/id"}}},
    "attemptFinish": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "participant_id", "status", "finished_at", "server_score", "history"], "properties": {"attempt_id": {"$ref": "#/$defs/id"}, "participant_id": {"$ref": "#/$defs/id"}, "status": {"const": "finished"}, "finished_at": {"type": "string", "format": "date-time"}, "server_score": {"type": "integer", "minimum": 0}, "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}}}}
  }
}
