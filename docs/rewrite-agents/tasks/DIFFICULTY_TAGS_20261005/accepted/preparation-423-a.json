    {"provider":"quiz","pack_id":"prep-ballet","question_id":"music-oct3-004","difficulty_level":2,"editorial_tag_ids":["domain:arts","skill:recognition","topic:ballet","topic:composers"],"context_tag_ids":["domain:arts","topic:ballet"],"rationale":"Чайковский и «Лебединое озеро» — очень узнаваемая пара; Адан и Стравинский остаются реальными балетными композиторами, но не меняют этот очевидный выбор.","confidence":"high","editorial_flags":[]},
